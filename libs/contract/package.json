{
  "//": "scripts/gen.ts imports openapi-typescript from the ROOT package.json (with typescript 5.9.3 for its peer); see the note there.",
  "name": "@offerlane/contract",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "gen": "tsx scripts/gen.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
