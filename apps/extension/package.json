{
  "name": "@offerlane/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development --outDir dist-dev",
    "build:test": "OFFERLANE_EXT_TEST=1 vite build --outDir dist-test",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@offerlane/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
