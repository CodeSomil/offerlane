{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offerlane",
  "version": "0.1.0",
  "identifier": "com.somilmanke.offerlane",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "npx -y pnpm@11.28.9 build" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Offerlane", "width": 900, "height": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/128x128.png"] }
}
